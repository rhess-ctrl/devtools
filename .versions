#!/usr/bin/env bash
# ---------------------------------------------------------------------
# NOTE: list the devtool symlinks using yq and a key/base entry list...
set -euo pipefail
source "$HOME/bin/utils/colors.sh"

PREFIX="--"
# HRULE:  46 + 2 + 2 == 50 total
HRULE="----------------------------------------------"
CACHE="$HOME/github/eswat2/devtools/.dev-cache.yaml"

processKeys () {
  local target="$1"
  local base="$2"

  local bucket="${HOME}${base}${target}"
  local tag="${bucket#$HOME/}"

  if [ -d "$bucket" ]; then
    if [ -L "$bucket" ]; then
      printf "%s ${BLUE}%20s${STOP} ${OK}\n" "$PREFIX" "$tag"
    else
      printf "%s %20s -- ${RED}%s${STOP}\n" "$PREFIX" "$tag" "WARNING"
    fi
  else
    printf "%s %20s -- ${RED}%s${STOP}\n" "$PREFIX" "$tag" "MISSING"
  fi
}

# yq v4: iterate the top-level list and emit "key<TAB>base"
yq e '.[] | select(.key != null and .base != null) | .key + "\t" + .base' "$CACHE" |
while IFS=$'\t' read -r key base; do
  processKeys "$key" "$base"
done

printf "${TIK}${TIK} ${HRULE} [ ${GREEN}%s${STOP} ]\n" "devtools-mac"
nit
